# Copy to .env and fill in. Every value is optional; the app runs without an
# API key and falls back to rule-based feedback.

# Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=

# Models tried in order (primary, then fallback)
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Local Ollama fallback, used when every Groq model fails (or GROQ_API_KEY is empty).
# Install from https://ollama.com, then: ollama pull mistral:7b
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434   # from Docker: http://host.docker.internal:11434
OLLAMA_MODEL=mistral:7b
OLLAMA_TIMEOUT=420

# Long random string, e.g. python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Optional
# DATABASE_URL=sqlite:///instance/resume_analyzer.db
# MAX_UPLOAD_MB=5
# ENABLE_EMBEDDINGS=true      # set false to skip the sentence-transformers model
# EMBED_MODEL_NAME=all-MiniLM-L6-v2
# ENABLE_HISTORY=true         # set false on public deployments to hide /history
# RATE_LIMIT_PER_10_MIN=10    # analyses per client per 10 minutes (0 disables)
# CACHE_DAYS=7                # reuse an identical AI report for this many days (0 disables)
# RETENTION_DAYS=0            # delete reports older than this at startup (0 keeps forever)
# FEEDBACK_WORKERS=2          # background threads writing AI feedback
